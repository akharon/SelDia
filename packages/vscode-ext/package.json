{
  "name": "seldia-vscode",
  "version": "1.77.0",
  "private": true,
  "displayName": "SelDiA",
  "description": "Unified Diagram-as-Code with Rough.js — 21+ diagram types, interactive editing, Markdown integration, PDF export",
  "publisher": "ThalesoMilas",
  "license": "AGPL-3.0-or-later",
  "author": "SelDiA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akharon/SelDia.git"
  },
  "bugs": {
    "url": "https://github.com/akharon/SelDia/issues"
  },
  "homepage": "https://github.com/akharon/SelDia#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "./media/icon.png",
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "diagram",
    "flowchart",
    "sequence",
    "class",
    "c4",
    "bpmn",
    "uml",
    "roughjs",
    "sketchy",
    "architecture",
    "visualization",
    "dsl"
  ],
  "activationEvents": [
    "onLanguage:seldia",
    "onLanguage:markdown",
    "onLanguageModelTool:seldia_validate"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/vendor-external-deps.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.4.0",
    "@seldia/core": "*",
    "@seldia/interaction": "*",
    "marked": "^15.0.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "seldia",
        "extensions": [
          ".sld",
          ".seldia"
        ],
        "aliases": [
          "SelDiA",
          "seldia"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "seldia",
        "scopeName": "source.seldia",
        "path": "./syntaxes/seldia.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "seldia.seldiaEditor",
        "displayName": "SelDiA Diagram Editor",
        "selector": [
          {
            "filenamePattern": "*.sld"
          },
          {
            "filenamePattern": "*.seldia"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "seldia.marpPreview",
        "displayName": "Marp Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.mdx"
          }
        ],
        "priority": "option"
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/seldia-preview.js"
    ],
    "markdown.previewStyles": [
      "./media/seldia-preview.css"
    ],
    "languageModelTools": [
      {
        "name": "seldia_validate",
        "toolReferenceName": "seldiaValidate",
        "displayName": "Validate SelDiA / Mermaid / PlantUML diagrams",
        "modelDescription": "Compiles diagrams and reports every problem with file:line, severity and message, so you can fix them. Supports SelDiA DSL (.sld/.seldia and ```seldia fences), Mermaid (.mmd and ```mermaid fences), PlantUML (.puml and ```plantuml/```puml fences), and circuit/pcb fences. For a Markdown file it checks every diagram fence and reports lines in the Markdown file. Errors mean the diagram does not render; warnings are Mermaid/PlantUML statements that are dropped on import, or SelDiA semantic problems. Call it after writing or editing any diagram and repeat until it reports 0 errors. Pass filePath to check a file (open editors' unsaved text is used), or code + language to check a snippet; with no arguments it checks the active editor. Set layout=true to also get readability defects (edge crossings, overlaps) with hints on how to fix them.",
        "userDescription": "Check SelDiA, Mermaid and PlantUML diagrams for errors.",
        "canBeReferencedInPrompt": true,
        "icon": "$(check-all)",
        "tags": ["seldia", "mermaid", "plantuml", "diagram", "validation"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Absolute or workspace-relative path to a .sld, .seldia, .md, .mmd or .puml file."
            },
            "code": {
              "type": "string",
              "description": "Diagram source to validate instead of a file (no Markdown fence markers unless language is markdown)."
            },
            "language": {
              "type": "string",
              "enum": ["seldia", "mermaid", "plantuml", "circuit", "pcb", "markdown"],
              "description": "Language of code, or override for filePath. Defaults to the file extension, else seldia."
            },
            "layout": {
              "type": "boolean",
              "description": "Also report layout readability defects with fix hints. Default false."
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "seldia.toggleView",
        "title": "SelDiA: Toggle Code / Diagram View"
      },
      {
        "command": "seldia.openPreview",
        "title": "SelDiA: Open Diagram in Markdown Preview"
      },
      {
        "command": "seldia.openInteractive",
        "title": "SelDiA: Open Interactive Diagram"
      },
      {
        "command": "seldia.editBlockVisually",
        "title": "SelDiA: Edit Diagram Block Visually"
      },
      {
        "command": "seldia.editTable",
        "title": "SelDiA: Edit Table"
      },
      {
        "command": "seldia.insertDiagram",
        "title": "SelDiA: Insert Diagram Block"
      },
      {
        "command": "seldia.exportDiagram",
        "title": "SelDiA: Export Diagram"
      },
      {
        "command": "seldia.exportToMermaid",
        "title": "SelDiA: Export Diagram to Mermaid"
      },
      {
        "command": "seldia.exportToPlantUml",
        "title": "SelDiA: Export Diagram to PlantUML"
      },
      {
        "command": "seldia.exportTableToMarkdown",
        "title": "SelDiA: Export Table to Markdown (GFM)"
      },
      {
        "command": "seldia.exportMarkdownToPdf",
        "title": "SelDiA: Export Markdown to PDF"
      },
      {
        "command": "seldia.revealSource",
        "title": "SelDiA: Reveal Diagram Source"
      },
      {
        "command": "seldia.openMarpPreview",
        "title": "SelDiA: Open Marp Slide Preview"
      },
      {
        "command": "seldia.exportMarp",
        "title": "SelDiA: Export Marp Deck (PDF/PPTX/HTML)"
      }
    ],
    "snippets": [
      {
        "language": "seldia",
        "path": "./snippets/seldia.code-snippets"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "seldia.toggleView",
          "when": "editorLangId == seldia",
          "group": "seldia@1"
        },
        {
          "command": "seldia.openPreview",
          "when": "editorLangId == seldia",
          "group": "seldia@2"
        },
        {
          "command": "seldia.exportDiagram",
          "when": "editorLangId == seldia",
          "group": "seldia@3"
        },
        {
          "command": "seldia.exportToMermaid",
          "when": "editorLangId == seldia",
          "group": "seldia@4"
        },
        {
          "command": "seldia.exportToPlantUml",
          "when": "editorLangId == seldia",
          "group": "seldia@5"
        }
      ],
      "editor/title": [
        {
          "command": "seldia.toggleView",
          "when": "editorLangId == seldia",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "seldia.toggleView",
          "when": "editorLangId == seldia"
        },
        {
          "command": "seldia.openPreview",
          "when": "editorLangId == seldia || editorLangId == markdown"
        },
        {
          "command": "seldia.insertDiagram",
          "when": "editorLangId == markdown"
        },
        {
          "command": "seldia.exportDiagram",
          "when": "editorLangId == seldia"
        },
        {
          "command": "seldia.exportToMermaid",
          "when": "editorLangId == seldia"
        },
        {
          "command": "seldia.exportToPlantUml",
          "when": "editorLangId == seldia"
        },
        {
          "command": "seldia.exportTableToMarkdown",
          "when": "editorLangId == seldia"
        },
        {
          "command": "seldia.exportMarkdownToPdf",
          "when": "editorLangId == markdown"
        },
        {
          "command": "seldia.openMarpPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "seldia.exportMarp",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "seldia.toggleView",
        "key": "ctrl+shift+v",
        "when": "editorLangId == seldia"
      },
      {
        "command": "seldia.openPreview",
        "key": "ctrl+k v",
        "when": "editorLangId == seldia || editorLangId == markdown"
      },
      {
        "command": "seldia.insertDiagram",
        "key": "ctrl+shift+i",
        "when": "editorLangId == markdown"
      }
    ],
    "walkthroughs": {
      "start": {
        "title": "Get Started with SelDiA",
        "description": "Learn how to create diagrams with SelDiA's unified DSL",
        "steps": [
          {
            "id": "createDiagram",
            "title": "Create a .sld file",
            "description": "Create a new file with the `.sld` extension and start typing. SelDiA's language server provides autocomplete, hover info, and real-time diagnostics.",
            "media": {
              "markdown": "media/walkthrough/create-diagram.md"
            }
          },
          {
            "id": "previewDiagram",
            "title": "Preview your diagram",
            "description": "Press `Ctrl+Shift+V` to toggle between code and rendered diagram view. Use `Ctrl+K V` to open the preview side-by-side.",
            "media": {
              "markdown": "media/walkthrough/preview-diagram.md"
            }
          },
          {
            "id": "markdownIntegration",
            "title": "Use diagrams in Markdown",
            "description": "In any `.md` file, wrap your SelDiA DSL in a ` ```seldia ` fenced code block. The diagram will auto-render inline.",
            "media": {
              "markdown": "media/walkthrough/markdown-integration.md"
            }
          },
          {
            "id": "exportPdf",
            "title": "Export to PDF",
            "description": "Run the 'SelDiA: Export Markdown to PDF' command to convert Markdown files with SelDiA diagrams to professional PDF documents.",
            "media": {
              "markdown": "media/walkthrough/export-pdf.md"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "SelDiA",
      "properties": {
        "seldia.defaultTheme": {
          "type": "string",
          "default": "sketchy-light",
          "enum": ["sketchy-light", "sketchy-dark", "clean-light", "clean-dark", "mono", "blueprint", "comic", "glow-dark", "glow-light"],
          "enumDescriptions": ["Hand-drawn, light","Hand-drawn, dark","Clean lines, light","Clean lines, dark","High-contrast monochrome","Blueprint","Comic","PAiRS-style dark: tinted nodes, accent bars, glow on focus","PAiRS-style light: tinted nodes, accent bars, glow on focus"],
          "description": "Default theme for rendered diagrams"
        },
        "seldia.markdown.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable SelDiA diagram detection in Markdown files"
        },
        "seldia.markdown.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Markdown preview when a Markdown file with SelDiA blocks is opened"
        },
        "seldia.markdown.toc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Inject an automatic Table of Contents (headings + numbered diagrams) at the top of the Markdown preview"
        },
        "seldia.markdown.captions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render numbered captions (\"Diagram 1\", \"Diagram 2\") under diagrams in the Markdown preview"
        },
        "seldia.markdown.tables.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Style GFM tables in the Markdown preview (zebra rows, sticky header, horizontal scroll) with an Edit table / Copy as CSV toolbar, and show an \"Edit Table\" CodeLens above tables. A document can opt out with `seldia_tables: false` in its front-matter."
        },
        "seldia.marp.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Marp slide preview when a Markdown file whose front-matter sets `marp: true` is opened. The built-in Markdown preview is left alone; this opens SelDiA's slide panel beside it."
        },
        "seldia.interactive.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable interactive editing (drag, double-click to edit) in the interactive editor for .sld files. Diagrams embedded in Markdown are always laid out automatically and previewed read-only."
        },
        "seldia.interactive.undoStackSize": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of undo steps for visual edits"
        },
        "seldia.export.defaultFormat": {
          "type": "string",
          "default": "svg",
          "enum": [
            "svg",
            "png",
            "pdf"
          ],
          "description": "Default export format"
        },
        "seldia.layout.engine": {
          "type": "string",
          "default": "dagre",
          "enum": [
            "dagre",
            "elk"
          ],
          "enumDescriptions": [
            "Fast, synchronous hierarchical layout (default). Used everywhere, including the Markdown preview.",
            "Eclipse Layout Kernel — layered algorithm, often higher quality for architecture diagrams. Async only: honored by export/CLI, but the Markdown preview falls back to dagre since it must render synchronously."
          ],
          "description": "Default automatic layout engine for diagrams. A diagram can override this per-file with `layout elk` / `layout dagre`."
        }
      }
    }
  }
}
