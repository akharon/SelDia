{
  "Flowchart": {
    "prefix": "seldia-flowchart",
    "body": [
      "diagram flowchart \"${1:My Flowchart}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark,clean-light,clean-dark,mono,glow-dark,glow-light|}\"",
      "",
      "\t// Nodes",
      "\tstart: (${3:Start})",
      "\tprocess: [${4:Process}]",
      "\tdecision: {${5:Decision?}}",
      "\tend: (${6:End})",
      "",
      "\t// Edges",
      "\tstart --> process",
      "\tprocess --> decision",
      "\tdecision -->|\"yes\"| end",
      "\tdecision -->|\"no\"| process",
      "}"
    ],
    "description": "Flowchart diagram"
  },
  "Sequence Diagram": {
    "prefix": "seldia-sequence",
    "body": [
      "diagram sequence \"${1:OAuth Flow}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t// Participants",
      "\tparticipant ${3:client}: \"${4:Client}\"",
      "\tparticipant ${5:server}: \"${6:Server}\"",
      "",
      "\t// Messages",
      "\t${3:client} -> ${5:server}: ${7:request}",
      "\t${5:server} --> ${3:client}: ${8:response}",
      "}"
    ],
    "description": "Sequence diagram"
  },
  "Class Diagram": {
    "prefix": "seldia-class",
    "body": [
      "diagram class \"${1:Order System}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t// Each class is a node whose label uses \\n for compartments:",
      "\t// first line = name, lines with () = methods, others = fields.",
      "\t${3:order}: \"${4:Order}\\n+${5:id}: ${6:UUID}\\n+${7:status}: ${8:string}\\n+${9:calculateTotal}(): ${10:Money}\"",
      "\t${11:item}: \"${12:OrderItem}\\n+${13:quantity}: ${14:int}\"",
      "",
      "\t// Relationship (cardinality goes in the edge label)",
      "\t${3:order} -->|\"1 : *\"| ${11:item}",
      "}"
    ],
    "description": "Class diagram"
  },
  "C4 Context Diagram": {
    "prefix": "seldia-c4-context",
    "body": [
      "diagram c4 context \"${1:System Context}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\tperson ${3:user}: \"${4:User}\" \"${5:A user of the system}\"",
      "\tsystem ${6:app}: \"${7:My System}\" \"${8:Description}\"",
      "\tsystem_Ext ${9:ext}: \"${10:External System}\" \"${11:External service}\"",
      "",
      "\t${3:user} --> ${6:app}: \"${12:Uses}\"",
      "\t${6:app} --> ${9:ext}: \"${13:Integrates}\"",
      "}"
    ],
    "description": "C4 Context diagram"
  },
  "C4 Container Diagram": {
    "prefix": "seldia-c4-container",
    "body": [
      "diagram c4 container \"${1:Container View}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\tcontainer ${3:spa}: \"${4:SPA}\" \"${5:React}\" \"${6:Client app}\"",
      "\tcontainer ${7:api}: \"${8:API}\" \"${9:Go}\" \"${10:REST API}\"",
      "\tcontainerDb ${11:db}: \"${12:Database}\" \"${13:PostgreSQL}\" \"${14:Stores data}\"",
      "",
      "\t${3:spa} --> ${7:api}: \"${15:JSON/HTTPS}\"",
      "\t${7:api} --> ${11:db}: \"${16:SQL/TCP}\"",
      "}"
    ],
    "description": "C4 Container diagram"
  },
  "State Diagram": {
    "prefix": "seldia-state",
    "body": [
      "diagram state \"${1:Order State}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t[*] --> ${3:Pending}: \"${4:create}\"",
      "\t${3:Pending} --> ${5:Approved}: \"${6:approve}\"",
      "\t${3:Pending} --> ${7:Cancelled}: \"${8:cancel}\"",
      "\t${5:Approved} --> ${9:Shipped}: \"${10:ship}\"",
      "\t${9:Shipped} --> [*]: \"${11:deliver}\"",
      "}"
    ],
    "description": "State diagram"
  },
  "Entity Relationship Diagram": {
    "prefix": "seldia-er",
    "body": [
      "diagram er \"${1:Data Model}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t// Each entity is a node; its label lists columns (PK/FK mark keys).",
      "\t${3:user}: \"${4:User}\\nid: UUID PK\\nname: string\\nemail: string\"",
      "\t${5:order}: \"${6:Order}\\nid: UUID PK\\nuserId: UUID FK\\ntotal: decimal\"",
      "",
      "\t${3:user} -->|\"1 : *\"| ${5:order}",
      "}"
    ],
    "description": "Entity-Relationship diagram"
  },
  "Gantt Chart": {
    "prefix": "seldia-gantt",
    "body": [
      "diagram gantt \"${1:Project Plan}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\tsection \"${3:Phase 1}\" {",
      "\t\t${4:t1}: [${5:Task 1}]",
      "\t\t${6:t2}: [${7:Task 2}]",
      "\t}",
      "",
      "\t// Arrows show task dependencies (order).",
      "\t${4:t1} --> ${6:t2}",
      "}"
    ],
    "description": "Gantt chart"
  },
  "Mind Map": {
    "prefix": "seldia-mindmap",
    "body": [
      "diagram mindmap \"${1:Mind Map}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\troot: (${3:Topic})",
      "\t${4:cat1}: [${5:Category 1}]",
      "\t${6:cat2}: [${7:Category 2}]",
      "",
      "\troot --> ${4:cat1}",
      "\troot --> ${6:cat2}",
      "}"
    ],
    "description": "Mind map"
  },
  "BPMN Diagram": {
    "prefix": "seldia-bpmn",
    "body": [
      "diagram bpmn \"${1:Process}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t// Shapes: (event) [task] {gateway}",
      "\t${3:start}: (${4:Start})",
      "\t${5:task1}: [${6:Do Something}]",
      "\t${7:gate}: {${8:Decision?}}",
      "\t${9:end}: (${10:End})",
      "",
      "\t${3:start} --> ${5:task1}",
      "\t${5:task1} --> ${7:gate}",
      "\t${7:gate} -->|\"yes\"| ${9:end}",
      "}"
    ],
    "description": "BPMN diagram"
  },
  "Markdown Fenced Block": {
    "prefix": "seldia-markdown",
    "body": [
      "```seldia",
      "diagram ${1|flowchart,sequence,class,c4-context,c4-container,state,er,gantt,mindmap,bpmn,dmn,network,component,deployment,usecase,activity,gitgraph,form,sankey,block,timeline|} \"${2:Title}\" {",
      "\t$0",
      "}",
      "```"
    ],
    "description": "SelDiA diagram fenced code block for Markdown"
  },
  "Network Diagram": {
    "prefix": "seldia-network",
    "body": [
      "diagram network \"${1:Network Topology}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t${3:internet}: [Internet]",
      "\t${4:firewall}: {Firewall}",
      "\t${5:switch}: [Switch]",
      "\t${6:server}: [Server]",
      "",
      "\t${3:internet} --> ${4:firewall}",
      "\t${4:firewall} --> ${5:switch}",
      "\t${5:switch} --> ${6:server}",
      "}"
    ],
    "description": "Network diagram"
  },
  "DMN Decision": {
    "prefix": "seldia-dmn",
    "body": [
      "diagram dmn \"${1:Loan Approval}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t// Model the decision as inputs feeding a decision node.",
      "\t${3:input}: [/${4:Applicant Data}/]",
      "\t${5:check}: {${6:Age >= 18?}}",
      "\t${7:approve}: (${8:Approve})",
      "\t${9:deny}: (${10:Deny})",
      "",
      "\t${3:input} --> ${5:check}",
      "\t${5:check} -->|\"yes\"| ${7:approve}",
      "\t${5:check} -->|\"no\"| ${9:deny}",
      "}"
    ],
    "description": "DMN decision"
  },
  "Component Diagram": {
    "prefix": "seldia-component",
    "body": [
      "diagram component \"${1:Architecture}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t${3:web}: [Web Frontend]",
      "\t${4:api}: [API Gateway]",
      "\t${5:auth}: [Auth Service]",
      "\t${6:db}: [Database]",
      "",
      "\t${3:web} --> ${4:api}",
      "\t${4:api} --> ${5:auth}",
      "\t${4:api} --> ${6:db}",
      "}"
    ],
    "description": "Component diagram"
  },
  "Deployment Diagram": {
    "prefix": "seldia-deployment",
    "body": [
      "diagram deployment \"${1:Deployment}\" {",
      "\ttheme \"${2|sketchy-light,sketchy-dark|}\"",
      "",
      "\t${3:app}: [App Server]",
      "\t${4:db}: [(Database)]",
      "\t${5:cdn}: [Static Assets / CDN]",
      "",
      "\t${5:cdn} --> ${3:app}: \"${6:API calls}\"",
      "\t${3:app} --> ${4:db}",
      "}"
    ],
    "description": "Deployment diagram"
  },
  "Table": {
    "prefix": "seldia-table",
    "body": [
      "table \"${1:Sales}\" {",
      "| ${2:Region} | ${3:Quarter} | ${4:Revenue} |",
      "|:--|:-:|--:|",
      "| ${5:North} | Q1 | 1,200 |",
      "| ^ | Q2 | 1,450 |",
      "| ${6:South} | Q1 | 980 |",
      "}"
    ],
    "description": "Table with merged cells (^ merges up, < merges left)"
  }
}
